# Spree API Configuration (server-side only)
SPREE_API_URL=http://localhost:3000
SPREE_PUBLISHABLE_KEY=your_publishable_api_key_here

# Korgoo store defaults. `docker compose exec rails bin/rails runner
# "puts Spree::Store.default.api_keys.active.publishable.first.token"` reads
# a publishable key for SPREE_PUBLISHABLE_KEY above.
NEXT_PUBLIC_DEFAULT_COUNTRY=kg
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SITE_URL=http://localhost:5173/store
NEXT_PUBLIC_STORE_NAME=Korgoo

# Emits `/store/...` asset and route URLs so `pnpm dev` (port 3001) works
# behind frontend/vite.config.ts's `/store` proxy. Leave unset in production —
# store.korgoo.kg serves this app from `/`.
NEXT_BASE_PATH=/store

# Stripe Configuration (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
